{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "dist/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.ts" },
    { "src": "/assets/(.*)", "dest": "dist/assets/$1" },
    {
      "src": "/(.*\\.(js|css|json|svg|png|jpg|jpeg|gif|woff|woff2))",
      "dest": "dist/$1"
    },
    { "src": "/.*", "dest": "dist/index.html" }
  ]
}
